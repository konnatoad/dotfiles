// Finnish (Windows) with fixes for 75% ANSI boards (Womier SK75) that lack the < > | key
// selected in hyprland.conf with: kb_layout = custom_fi, kb_variant = basic

default partial alphanumeric_keys
xkb_symbols "basic" {
    include "fi(winkeys)"
    name[Group1]= "Finnish (Custom, SK75)";

    // AltGr + , . -  ->  < > |
    key <AB08> { [ comma,  semicolon,  less,    NoSymbol ] };
    key <AB09> { [ period, colon,      greater, NoSymbol ] };
    key <AB10> { [ minus,  underscore, bar,     NoSymbol ] };

    // AltGr + ¨  ->  ~ right away (not a dead key, no space needed)
    key <AD12> { [ dead_diaeresis, dead_circumflex, asciitilde, dead_macron ] };

    include "level3(ralt_switch)"
};
