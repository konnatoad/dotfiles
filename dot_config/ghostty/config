# background = #000000  (now from noctalia theme)
# foreground = #FFFFFF  (now from noctalia theme)
background-opacity = 0.75
background-blur = true

font-family = "JetBrainsMono Nerd Font"
font-size = 12
theme = noctalia

# liquid cursor trail (gpu shader), same color as the cursor
custom-shader = ~/.config/ghostty/shaders/cursor_liquid.glsl
custom-shader-animation = true

# noctalia's monochrome palette turns these into greys; keep them vivid (same as nvim's catppuccin)
palette = 1=#f38ba8
palette = 9=#f5a3b9
palette = 2=#a6e3a1
palette = 10=#bdf0b8
palette = 4=#89b4fa
palette = 12=#a7c6fc
